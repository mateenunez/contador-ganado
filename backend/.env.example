# 1. Crea una cuenta gratuita en https://roboflow.com
# 2. En tu perfil -> Settings -> API Keys -> copia tu Private API Key
ROBOFLOW_API_KEY=your_private_api_key_here

# 3. Busca un modelo en https://universe.roboflow.com (por ejemplo "cattle aerial" o "cow detection")
#    En la pagina del modelo -> Deploy -> copia el Model ID + version
#    Formato: workspace/model-name/version  ->  ej: john/cow-detection/1
ROBOFLOW_MODEL=workspace/model-name/1

# Umbral de confianza: detecciones por encima de este valor se muestran (0.0 a 1.0)
CONFIDENCE=0.4

# Superposicion maxima entre bounding boxes (evita contar el mismo animal dos veces)
OVERLAP=0.3

# Origenes permitidos para CORS, separados por coma
ALLOWED_ORIGINS=http://localhost:5173

# Limite de tamano de archivo subido, en MB
MAX_UPLOAD_MB=15
